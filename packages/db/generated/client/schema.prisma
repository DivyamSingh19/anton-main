generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String
  createdAt    String
  sessions     UserSessions[]
  projects     UserProject[]
  profile      UserProfile?
  platforms    UserPlatforms[]
}

model UserSessions {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  lastLogin String
  createdAt DateTime
  updatedAt DateTime
}

model Engineer {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  createdAt    DateTime
  updatedAt    DateTime
  orgId        String
  profile      EngineerProfile?
  organization Organization     @relation(fields: [orgId], references: [id])
}

model Organization {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime
  updatedAt    DateTime
  engineers    Engineer[]
  admins       Admin[]
}

model Admin {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime
  updatedAt    DateTime
  orgId        String
  profile      AdminProfile?
  organization Organization  @relation(fields: [orgId], references: [id])
}

model UserProject {
  id          String        @id @default(uuid())
  userId      String
  projectId   String
  user        User          @relation(fields: [userId], references: [id])
  status      ProjectStatus
  description String?
  name        String
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model UserProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id])
  bio       String?
  avatarUrl String?
}

model AdminProfile {
  id        String  @id @default(uuid())
  adminId   String  @unique
  admin     Admin   @relation(fields: [adminId], references: [id])
  bio       String?
  avatarUrl String?
}

model EngineerProfile {
  id         String   @id @default(uuid())
  engineerId String   @unique
  engineer   Engineer @relation(fields: [engineerId], references: [id])
  bio        String?
  avatarUrl  String?
}

model UserPlatforms {
  id             String @id @default(uuid())
  userId         String
  platformName   String
  platformUserId String
  user           User   @relation(fields: [userId], references: [id])
}
